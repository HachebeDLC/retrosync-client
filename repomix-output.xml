    return SystemInfo(
      id: json['id'] ?? '',
      name: json['name'] ?? '',
      folders: List<String>.from(json['folders'] ?? []),
      extensions: List<String>.from(json['extensions'] ?? []),
      ignoredFolders: List<String>.from(json['ignored_folders'] ?? []),
